# mppkb UI bridge deployment environment.
# Copy to .env, fill values, NEVER commit real secrets.
# Docker Compose uses /data paths; for a bare-metal install edit paths to the host.

# ---------- server ----------
# Used by run-bridge.ps1 / run-bridge.sh; the bridge itself takes --host/--port.
MPPKB_HOST=127.0.0.1
MPPKB_PORT=8791

# ---------- knowledge base ----------
MPPKB_KB_DB=/data/kb.sqlite
MPPKB_CORPUS_DB=/data/corpus.sqlite
MPPKB_CORPUS_DIR=/data/pdfs
MPPKB_CHROMA_DIR=/data/chroma
MPPKB_ONTOLOGY=/app/ontology.yaml

# ---------- retrieval ----------
# lexical (no cloud key) or hybrid (needs MPPKB_API_KEY + chromadb)
MPPKB_RETRIEVAL_MODE=lexical
# MPPKB_API_KEY=sk-...
# MPPKB_LLM_MODEL=qwen-plus
# MPPKB_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# MPPKB_LLM_JSON_MODE=1

# ---------- review ----------
MPPKB_REVIEWER=clinical-reviewer
MPPKB_REVIEW_SLA_HOURS=24
MPPKB_REVIEW_SLA_WARN_HOURS=4
# Re-run historical answers after each decision (stores question text).
MPPKB_ANSWER_WRITEBACK=0

# ---------- PHI / retention ----------
# 0 = do not persist question text at all (audit keeps question_hash only).
MPPKB_STORE_ANSWER_QUESTION=1
# Question text is nulled after this many days; 30 is the default.
MPPKB_QUESTION_RETENTION_DAYS=30

# ---------- SLA scheduler ----------
# 1 = background thread checks overdue items and sends notifications.
MPPKB_SLA_SCHEDULER=0
MPPKB_SLA_INTERVAL_SECONDS=300
MPPKB_SLA_NOTIFY_COOLDOWN_HOURS=4

# ---------- notification channels (at least one for scheduler) ----------
# Generic IM webhook: receives JSON {"text","overdue","due_soon"}.
MPPKB_SLA_WEBHOOK_URL=
# SMTP fallback (both host and TO required).
MPPKB_SMTP_HOST=
MPPKB_SMTP_PORT=587
MPPKB_SMTP_USER=
MPPKB_SMTP_PASS=
MPPKB_SMTP_FROM=
MPPKB_SMTP_TO=
# 0 disables STARTTLS (not recommended).
MPPKB_SMTP_TLS=1
