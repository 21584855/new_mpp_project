# Reverse proxy for the mppkb UI bridge.
# Install as /etc/nginx/conf.d/mppkb.conf and replace example.com / certificate paths.

upstream mppkb_ui {
    server 127.0.0.1:8791;
    keepalive 16;
}

server {
    listen 80;
    server_name mppkb.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name mppkb.example.com;

    ssl_certificate     /etc/letsencrypt/live/mppkb.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mppkb.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;
    access_log /var/log/nginx/mppkb-ui.access.log;
    error_log  /var/log/nginx/mppkb-ui.error.log;

    # Optional: restrict to the hospital network / VPN.
    # allow 10.0.0.0/8;
    # deny all;

    # Optional: add HTTP basic auth in front of human review.
    # auth_basic "mppkb review";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://mppkb_ui;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/health {
        proxy_pass http://mppkb_ui;
        access_log off;
    }
}
